# =============================================================================
# ProductAssistant | infra/.env.template
# 用途    : .env 的入库模板（键清单 + 默认值 + 占位符）。复制为 infra/.env 后填入真实值。
# 安全红线: 真实密钥禁止入库；.env 已在 .gitignore 中忽略。
# 契约    : 本文件是「有哪些环境变量、默认值是什么、为什么」的唯一入库来源。
#           · 未注释的键（active）必须全部出现在 infra/.env 中；
#           · 已注释的键 = 可选覆盖项（如两个 DSN），允许在 .env 中缺省。
# 新增变量流程:
#           ① 先在本文件登记（含默认值与说明注释）
#           ② ./infra/scripts/env-init.sh    # 只追加 .env 缺失的键，绝不覆盖已有值
#           ③ ./infra/scripts/env-check.sh   # 自检：缺键 / 未登记键 / 弱口令（--prod 更严）
# =============================================================================

# --- PostgreSQL（宿主机本地实例；非 Docker）---
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=productassistant
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL 角色密码（由 infra/scripts/pgsql-setup.sh 以 psql 变量注入）---
ROLE_PA_ADMIN_PWD=CHANGE_ME
ROLE_PA_BACKEND_PWD=CHANGE_ME
ROLE_PA_AI_PWD=CHANGE_ME
ROLE_PA_AI_SETUP_PWD=CHANGE_ME

JWT_SECRET=CHANGE_ME

# --- Redis（事件总线 / 缓存 / 锁；本机 docker 实例，宿主端口见 REDIS_PORT）---
REDIS_URL=redis://localhost:6379/0
# 生产 Redis 鉴权：本地可留空；生产填真实密码并把 REDIS_URL 改为 redis://:<pwd>@host:6379/0
# （infra/docker-compose.redis-prod.yml 以 requirepass ${REDIS_PASSWORD} 拉起独立实例）
REDIS_PASSWORD=
# 生产 Redis 内存上限与 fsync 策略：仅在自建 Redis（docker-compose.redis-prod.yml）时生效。
# ⚠️ 淘汰策略固定 noeviction（见该文件注释）：队列绝不能被 LRU 淘汰，否则会静默丢任务。
# appendfsync everysec = 崩溃最多丢 1 秒写入；要求零丢失改 always（性能代价明显）。
REDIS_MAXMEMORY=2gb
REDIS_APPENDFSYNC=everysec

# --- Milvus（RAG 向量库；集合名 pa_listing_vec，固定名不带环境前缀）---
MILVUS_URI=http://localhost:19530
MILVUS_DIM=1024

# --- MinIO（Milvus 依赖的对象存储；仅 infra/docker-compose.yml 的 ${} 替换消费，代码不读）---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- ai-engine 运行入口（`cd ai-engine && python -m src.service`）---
# 说明：两个 DSN 可显式给出；也可留空，由 __main__ 用上面的 POSTGRES_* 与 ROLE_PA_AI*_PWD 自动拼装。
# PA_ENV 参与 Redis 键前缀 pa:{env}:...，生产端与消费端必须一致；生产必须显式改 prod。
PA_ENV=dev
# 运行期 DSN：role_pa_ai（schema_pa_ai 业务表 + checkpoint 表读写）
# AI_ENGINE_PG_DSN=postgresql://role_pa_ai:CHANGE_ME@localhost:5432/productassistant
# 建表 DSN：role_pa_ai_setup（仅首次/迁移建 checkpoint 系列表，需 CREATE）
# AI_ENGINE_SETUP_PG_DSN=postgresql://role_pa_ai_setup:CHANGE_ME@localhost:5432/productassistant
# 商品标题阻断级（high/medium）违禁词预检（**默认开**；显式置 0/false/no/off 才关闭）
# 为什么默认开：关着的时候"标题违规也照样生成上架"（2026-09 实测），合规配置在基础信息侧形同不存在。
# 命中即发 failed 事件 + 商品回 draft，且原因随结果回传（商品详情页「最近一次任务失败原因」可见）。
AI_ENGINE_RULE_PRECHECK=1

# --- ai-engine 消息可靠性（PEL 回收 / DLQ / 流保留 / 心跳）---
# 为什么需要：worker 崩溃或处理中异常时，消息会留在消费组待处理列表（PEL）里没有任何人再处理。
#   · 回收：每轮消费前用 XAUTOCLAIM 把「空闲超过 PEL_MIN_IDLE_MS」的消息转给自己重试；
#   · 死信：同一消息投递次数达 MAX_DELIVERIES 仍失败 → 转 pa:{env}:dlq:{流名} 并 ack 原消息；
#           有线程锁的 generate/approval 在「锁仍存在」时跳过（避免把正常的慢任务误判为毒消息，
#           锁不在且消息仍在 PEL = 处理过程中崩溃/异常未 ack，才是真死信）；
#   · 保留：job/result 流按 MAXLEN 近似裁剪；evt 流额外设 TTL（线程结束后仍可回放一段时间）。
# 调参口径：
#   · PEL_MIN_IDLE_MS 应 > 单次任务最长耗时，否则慢任务会被别的实例抢先接管（默认 60s 对 30s~2min 的生成偏紧，生产建议 300000）；
#   · JOB_LOCK_TTL_SECONDS 应 >= 单次任务最长耗时（锁是「回收时跳过」的判据，也是防重复处理的互斥）；
#   · STREAM_MAXLEN_EVT 只影响「断线回放深度」，不影响正在连接的 SSE（2000 ≈ 20+ 次完整生成的打字机事件）；
#   · DONE_TTL_SECONDS 是终态幂等标记 pa:{env}:done:{thread_id} 的存活期（仅 published 时写入）。
AI_ENGINE_PEL_MIN_IDLE_MS=60000
AI_ENGINE_MAX_DELIVERIES=5
AI_ENGINE_PEL_CLAIM_BATCH=10
AI_ENGINE_JOB_LOCK_TTL_SECONDS=300
AI_ENGINE_STREAM_MAXLEN_JOB=10000
AI_ENGINE_STREAM_MAXLEN_EVT=2000
AI_ENGINE_EVT_TTL_SECONDS=604800
AI_ENGINE_DONE_TTL_SECONDS=604800
AI_ENGINE_HEARTBEAT_TTL_SECONDS=30

# --- ai-engine Agent 研究（默认开，可关）---
# 默认图内会多一轮「只读工具取证」（function calling + 中间件预算熔断）：
#   · 收益：用真库素材 / 历史违规点 / 审批驳回意见校准事实（agent_context 会拼进生成提示词）；
#   · 代价：单任务模型调用数上升（主链路 4 次 → 最多 8 次以上，token 随之上升），且会改写最终文案；
#   · 需 ZHIPU_API_KEY 可用，否则节点 no-op（无凭据不会报错）；
#   · 关闭方式：置 0/false/no/off（关闭后链路行为与未接入 Agent 时完全一致）。
AI_ENGINE_AGENT_ENABLED=1
# 默认预算刻意收紧（Agent 默认开 → 用更紧的调用上限兜住成本增量），需要多轮取数的部署再调高；
# ⚠️ max_turns 不建议低于 2（1 轮取证不足，模型来不及「工具结果 → 结论」的第二次往返）。
AI_ENGINE_AGENT_MAX_TURNS=2
AI_ENGINE_AGENT_MAX_TOOL_CALLS=3
# --- ai-engine 日志级别（DEBUG/INFO/WARNING/ERROR）---
# 不配也行（代码默认 INFO）；配了才能给「[worker] …」日志加时间戳之外再调级别
# （装配见 ai-engine/src/service/logging_setup.py：print → 带时间戳的 log()，并给 logging 装 handler）
AI_ENGINE_LOG_LEVEL=INFO

# --- ai-engine 生图与图片规格化（AI 配图）---
# 生图模型：glm-image（默认 1280x1280；自定义需 1024-2048 且为 32 的整数倍）
#          cogview-4 / cogview-3-flash（默认 1024x1024；自定义需 512-2048 且被 16 整除）
# 尺寸由 adapters/llm_image_cogview.resolve_image_size() 按模型收敛，非法值自动回退默认并记 warning。
ZHIPU_IMAGE_MODEL=
# 平台水印：默认 0（关闭显式 + 隐式水印）。关闭前提是已在智谱控制台签署免责声明
# （个人中心-安全管理-去水印管理）；关闭后标识义务由本项目履行 —— AI 产物在规格化时写入
# AI 生成标识元数据（adapters/image_pillow.py）。若置 1 保留平台隐式水印，则不要再让 Pillow
# 重编码 AI 产物（重编码会丢弃元数据，可能触及「不得隐匿标识」条款）。
ZHIPU_IMAGE_WATERMARK=0
# 图片规格化（AI 图 + 上传图统一为 1:1、白底补边、不裁剪、默认不放大）
IMAGE_NORMALIZE_ENABLED=1
IMAGE_NORMALIZE_SIZE=1000x1000
IMAGE_NORMALIZE_FORMAT=jpeg
IMAGE_NORMALIZE_QUALITY=85
IMAGE_NORMALIZE_BACKGROUND="#FFFFFF"
IMAGE_NORMALIZE_UPSCALE=0

# --- LLM / Embedding 供应商（智谱单一基线；Embedding 复用 ZHIPU_API_KEY）---
# 置 LLM_PROVIDER=mock 时所有网关显式回退内存 mock（等价「不接真实模型」的离线模式）。
LLM_PROVIDER=zhipu
ZHIPU_API_KEY=CHANGE_ME
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_GENERATE_MODEL=glm-4-flash
ZHIPU_EVALUATE_MODEL=glm-4-flash
# Embedding（RAG/Milvus）：维度须与 MILVUS_DIM / 集合 pa_listing_vec 对齐
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- 多渠道审批通知（console=仅打印模拟；live=真实投递，仅「配了凭据」的渠道生效）---
# 置 live 时至少补齐一个渠道凭据，否则退化为「不出站」（当前仅实现了钉钉 webhook）。
NOTIFY_MODE=console
NOTIFY_DINGTALK_WEBHOOK_URL=

# --- 阿里云 OSS 对象存储（图文详情：商品图 / AI 配图；bucket 需设公有读 + CORS）---
# ⚠ OSS_BUCKET 必须是**该 AK 名下、且与 OSS_ENDPOINT 同地域**的已存在 bucket：
#   桶不存在时启动自检会打印「⚠ 对象存储自检失败…NoSuchBucket」，且每次配图都会**静默降级**为纯文本
#   （页面表现为「一直没有配图」，而任务状态是 succeeded）——2026-09 实测踩过这个坑。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME

# --- backend-api 运行入口（`cd backend-api && uvicorn pa_backend.main:app --app-dir src`）---
# DSN 可显式给出；留空时由 config 用上面的 POSTGRES_* + role_pa_backend / ROLE_PA_BACKEND_PWD 自动拼装。
# 角色红线：backend-api 只以 role_pa_backend 连库（schema_pa_backend 全 DML；schema_pa_ai 仅 SELECT）。
# 注意 DSN 必须带 +psycopg 驱动标记（SQLAlchemy async 口径），与 ai-engine 的纯 psycopg DSN 写法不同。
# BACKEND_PG_DSN=postgresql+psycopg://role_pa_backend:CHANGE_ME@localhost:5432/productassistant
BACKEND_PORT=8000
# 前端来源白名单（逗号分隔；仅本地 dev 需要用 CORS，生产由 nginx 同源反代，不再需要跨域）
# 说明：桌面端 :5173 与移动端 :5174 都通过 vite 的 /api 代理访问后端 → 默认**不需要**在这里加 5174；
#      只有当你绕过代理、让 H5 直连 http://<host>:8000（例如真机上做对比排查）时，
#      才把该来源（含局域网 IP，如 http://192.168.1.5:5174）显式加进白名单。
BACKEND_CORS_ORIGINS=http://localhost:5173
# --- backend-api 会话（access 短时效 + refresh HttpOnly Cookie；轮换状态存 Redis）---
BACKEND_ACCESS_TOKEN_MINUTES=15
BACKEND_REFRESH_DAYS=7
BACKEND_REFRESH_COOKIE_NAME=pa_refresh
# JWT 签名算法：仅在需要与既有网关对接时改动，默认 HS256
BACKEND_JWT_ALGORITHM=HS256
# 生产必须置 1（Cookie 仅 HTTPS 回传）；本地 http 开发置 0，否则浏览器不存 Cookie
BACKEND_COOKIE_SECURE=0
# --- backend-api 自助注册开关（注册 = 新开租户 + 该租户首个 admin）---
# 默认**关闭**（代码默认 False：不配即关闭，无需为本键改动任何既有 .env）。
# 为什么默认关：公网可自助开租户等于把多租户数据面直接对外开放；现阶段租户/账号由运维开通
# （backend-api tools/seed_super_admin.py）。关闭时 POST /auth/register 返回 403。
# 恢复自助注册需要**两处同时改**：这里置 1 + frontend/src/services/features.ts 的
# SELF_REGISTRATION_ENABLED 改 true（只改一处会出现「UI 有入口但接口 403」或反过来的裂缝）。
# BACKEND_ALLOW_REGISTRATION=0
#
# --- 引导平台超管（一次性；仅 backend-api tools/seed_super_admin.py 读取，运行期不参与任何逻辑）---
# 该账号是**跨租户**的（带 X-Org-Id 头可切到任意组织，见 backend-api core/deps），一旦泄露
# 等于整套系统 + 全部租户数据被接管 ⇒ 口令必须 16+ 位强随机，不要用手机号/工号这类可猜值。
# 口令**不得**写进本模板（模板入库）；仅当需要「无交互引导」时，才在 infra/.env 里取消注释填值：
#   · 推荐：交互执行（getpass 输入 —— 口令不进 .env、不进 history、不进进程 env）
#   · 无交互部署：在 .env 填值跑一次，之后可再注释掉（脚本不会覆盖已存在账号的口令，
#     轮换需显式 --reset-password）
# 用户名勿用 admin：sys_users 的用户名只在组织内唯一，跨组织同名要靠 org_name 消歧，
# 与业务租户的 admin 撞名会导致登录 400（见 services/auth_service）。
# BOOTSTRAP_ADMIN_USERNAME=superadmin
# BOOTSTRAP_ADMIN_ORG_NAME=平台管理
# BOOTSTRAP_ADMIN_PASSWORD=
# --- backend-api SSE（evt:{thread_id} 回放 / 尾随）---
# stream_ticket_ttl：SSE 长连接与短时效 access 解耦用的短时签名票据（换票后带 ticket 建连）
# stream_idle：无事件长连接空闲上限（秒），到点关流，前端按 Last-Event-ID 自动续连
BACKEND_STREAM_TICKET_TTL_SECONDS=120
BACKEND_STREAM_IDLE_SECONDS=120
# --- backend-api 僵死任务回收（reaper：卡在 running 的任务会永久 409 / 前端按钮不可点）---
# stale_minutes：任务多久没推进就判死（job→failed、商品→draft，可重新生成）。
#   必须远大于正常生成耗时（实测 <1min 量级）——宁可晚收也不误杀。
# interval：后台扫描间隔（秒）。
BACKEND_JOB_STALE_MINUTES=15
BACKEND_JOB_REAPER_INTERVAL_SECONDS=60
# --- backend-api 日志级别（DEBUG/INFO/WARNING/ERROR；访问日志 logger = pa_backend.access）---
BACKEND_LOG_LEVEL=INFO
# --- backend-api 登录失败限流（维度 = 用户名 + 客户端 IP；窗口内失败达阈值则锁定）---
BACKEND_LOGIN_MAX_FAILURES=5
BACKEND_LOGIN_FAILURE_WINDOW_SECONDS=300
BACKEND_LOGIN_LOCKOUT_SECONDS=900
# --- backend-api OSS 预签名直传（浏览器 PUT 直传，不经 backend 字节流）---
BACKEND_OSS_PRESIGN_EXPIRE_SECONDS=600
# 上传体积上限（字节，默认 10MB）：预签名阶段即拒绝，避免先传后拒
BACKEND_OSS_MAX_UPLOAD_BYTES=10485760
# 审批通知深链的站点入口（钉钉/邮件摘要里的「去审批」跳转基点）
BACKEND_FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
# 审批深链一次性签名票据 TTL（天）：只携带「跳到哪个待办」，真正审批仍走登录态 + CAS
BACKEND_APPROVAL_TICKET_TTL_DAYS=7

# =============================================================================
# --- 生产部署（阿里云 ECS + GitHub Actions + ACR）---
# 说明：上面的键**开发与生产共用同一份契约**；下面这组只被
#   infra/docker-compose.prod.yml 与 infra/nginx 读取（本地开发完全不读）。
#   完整初始化 / 发布 / 回滚 / 排障：infra/docs/deploy.md
# 生产必须同时改的键（不改 = "能跑但不对"，逐条理由见 docs/deploy.md §4）:
#   PA_ENV=prod                             → Redis 键前缀 pa:prod:*（生产端与消费端必须一致）
#   POSTGRES_HOST=host.docker.internal      → 应用在容器里，连宿主 PG 必须走网关别名
#   REDIS_URL=redis://:<pwd>@redis:6379/0   → 容器内用服务名（不是 localhost）
#   REDIS_MAXMEMORY=256mb                   → 1.6GB 内存的机器必须下调（默认 2gb 会撑爆容器）
#   BACKEND_COOKIE_SECURE=1                 → refresh cookie 只走 HTTPS
#   BACKEND_CORS_ORIGINS=（留空即不启用）    → 同源反代不需要跨域
#   BACKEND_FRONTEND_PUBLIC_BASE_URL=https://<域名>/m   → 审批深链落到移动端 H5
#   AI_ENGINE_AGENT_ENABLED=0               → 2C2G 先关（多一轮模型调用 = 内存/token 双涨）
#   MILVUS_URI=（留空）                      → 未启用 rag profile 时干净关闭 RAG
# =============================================================================

# --- 边缘 nginx（对外域名与端口；安全组需放行 EDGE_HTTP_PORT / EDGE_HTTPS_PORT）---
# 仅用于文档与证书签发口径；nginx 侧是 `server_name _` + 单域名证书，不读本键
PA_DOMAIN=seektruth.org.cn
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# --- 镜像仓库（阿里云 ACR 个人版：一个仓库 + 模块前缀 tag，如 …:backend-<sha>）---
# 服务器**必须**用 VPC 域名（同地域、免公网流量费、更快）—— 注意中间的 "-vpc"：
#   CI 推送（公网）：crpi-<id>.cn-shanghai.personal.cr.aliyuncs.com/<命名空间>/<仓库>
#   服务器拉取（VPC）：crpi-<id>-vpc.cn-shanghai.personal.cr.aliyuncs.com/<命名空间>/<仓库>
# 为什么必须派生两个域名：GitHub runner 在境外、走公网；ECS 在 VPC 内、走内网端点。
PA_IMAGE_REGISTRY=crpi-7sj157u0r3y1jvd8-vpc.cn-shanghai.personal.cr.aliyuncs.com/lihaixing-docker-image-rep/application_assistant
# 镜像 tag：CI 写入 git sha（PA_IMAGE_TAG=<sha>）→ **回滚就是把它改回上一个 sha 再 up -d**；
# 若你换成别的 ACR 命名空间/仓库，改上面 PA_IMAGE_REGISTRY 即可，tag 命名规则不变
PA_IMAGE_TAG=latest


