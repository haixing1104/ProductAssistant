{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@pa/core/*": ["../frontend/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../frontend/src/api", "../frontend/src/services", "../frontend/src/store", "../frontend/src/types"]
}
